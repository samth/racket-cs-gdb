diff --git a/src/chez_mode.ml b/src/chez_mode.ml
new file mode 100644
index 0000000..73c0551
--- /dev/null
+++ b/src/chez_mode.ml
@@ -0,0 +1,603 @@
+open! Core
+
+(* Chez Scheme (and so Racket CS) calls and returns with [jmp]s on x86_64:
+
+   - a non-tail call stores its return address in the frame and jumps:
+     [lea ret(%rip),%reg; mov %reg,0x0(%r13); jmp target]
+   - a tail call jumps to a code object's entry without storing one
+   - a return jumps through the frame: [jmp *0x0(%r13)], or, for a single-value
+     return through a register, [jmp *%r12], or for multiple values to the
+     mv-return address stored 0x20 bytes before the return point
+
+   perf flags all of these as plain jumps, so the trace writer would treat every Chez
+   call as a tail call and show flat stacks. This module sits between [perf script]
+   and the writer: it reads the code bytes from the jitdump that Chez writes
+   (CHEZ_JITDUMP=dir, CHEZ_JITDUMP_TSC=1) and turns those jumps into the [Call],
+   [Return] and [Jump] events the writer understands.
+
+   It keeps its own copy of each thread's stack, with the return address of each
+   frame, and updates it exactly as the writer updates its stack for the events
+   it passes on. That lets it pop several frames at once (escapes, C returns into
+   Scheme) by emitting several [Return]s, and resynchronize when a return matches no
+   frame. *)
+
+module Extra = struct
+  type t =
+    { src_dso : string
+    ; dst_dso : string
+    ; ilen : int
+    ; is_jcc : bool
+    }
+end
+
+module Jitdump = struct
+  type t =
+    { data : string
+    ; (* code index -> (code address, offset of the code bytes in [data], size) *)
+      code : (int, int64 * int * int) Hashtbl.t
+    }
+
+  let load path =
+    let data = In_channel.read_all path in
+    let code = Hashtbl.create (module Int) in
+    let len = String.length data in
+    if len >= 12 && Int32.(Stdlib.String.get_int32_le data 0 = 0x4A695444l)
+    then (
+      let hdr_size = Int32.to_int_exn (Stdlib.String.get_int32_le data 8) in
+      let rec loop pos =
+        if pos + 16 <= len
+        then (
+          let id = Int32.to_int_exn (Stdlib.String.get_int32_le data pos) in
+          let size = Int32.to_int_trunc (Stdlib.String.get_int32_le data (pos + 4)) in
+          if size >= 16 && pos + size <= len
+          then (
+            if id = 0 && size >= 56
+            then (
+              (* JIT_CODE_LOAD: id, size, time, pid, tid, vma, code_addr, code_size,
+                 code_index, name\0, code *)
+              let addr = Stdlib.String.get_int64_le data (pos + 32) in
+              let csize = Int64.to_int_exn (Stdlib.String.get_int64_le data (pos + 40)) in
+              let index = Int64.to_int_exn (Stdlib.String.get_int64_le data (pos + 48)) in
+              match String.index_from data (pos + 56) '\000' with
+              | Some nend when nend + 1 + csize <= len ->
+                Hashtbl.set code ~key:index ~data:(addr, nend + 1, csize)
+              | _ -> ());
+            loop (pos + size)))
+      in
+      loop hdr_size);
+    { data; code }
+  ;;
+end
+
+let jitted_re = Re.Perl.re {|^(.*)/jitted-([0-9]+)-([0-9]+)\.so$|} |> Re.compile
+
+module Frame = struct
+  type t =
+    { loc : Event.Location.t
+    ; ret : int64 option
+    ; mvret : int64 option
+    ; path : string (* folded-stack key of this frame and the ones below it *)
+    ; run : int (* how many frames in a row, ending here, have this frame's symbol *)
+    }
+end
+
+module Thread_state = struct
+  type t =
+    { mutable stack : Frame.t list
+    ; mutable depth : int
+    ; mutable last_time : Time_ns.Span.t option
+    ; mutable tracing_stopped : bool (* saw a trace end, so the next start resumes it *)
+    ; saved : (int64, Frame.t list) Hashtbl.t
+        (* for each return address, the stack as it was when a frame waiting for it
+           was last pushed (that frame on top); lists share structure, so this is cheap *)
+    }
+end
+
+type t =
+  { jitdumps : (string, Jitdump.t option) Hashtbl.t
+  ; threads : (Event.Thread.t, Thread_state.t) Hashtbl.t
+  ; stats : (string, int) Hashtbl.t
+  ; entries : (string, int) Hashtbl.t
+  ; folded : (string, int) Hashtbl.t option
+  ; mutable max_depth : int
+  ; depth_hist : (int, int) Hashtbl.t
+  }
+
+let create ~fold =
+  { jitdumps = Hashtbl.create (module String)
+  ; threads = Hashtbl.create (module Event.Thread)
+  ; stats = Hashtbl.create (module String)
+  ; entries = Hashtbl.create (module String)
+  ; folded = (if fold then Some (Hashtbl.create (module String)) else None)
+  ; max_depth = 0
+  ; depth_hist = Hashtbl.create (module Int)
+  }
+;;
+
+let count t key = Hashtbl.incr t.stats key
+
+(* the code object containing [dso]'s code, from the jitdump next to the
+   jitted-PID-INDEX.so file that [perf inject --jit] made from it *)
+let code_of t dso =
+  match Re.exec_opt jitted_re dso with
+  | None -> None
+  | Some g ->
+    let path = [%string "%{Re.Group.get g 1}/jit-%{Re.Group.get g 2}.dump"] in
+    let index = Int.of_string (Re.Group.get g 3) in
+    let jd =
+      Hashtbl.find_or_add t.jitdumps path ~default:(fun () ->
+        match Jitdump.load path with
+        | jd -> Some jd
+        | exception exn ->
+          eprint_s [%message "chez mode: cannot read jitdump" path (exn : exn)];
+          None)
+    in
+    Option.bind jd ~f:(fun jd ->
+      Option.map (Hashtbl.find jd.code index) ~f:(fun (addr, off, size) ->
+        jd.data, addr, off, size))
+;;
+
+let is_jitted dso = Re.execp jitted_re dso
+let byte s i = Char.to_int (String.unsafe_get s i)
+
+(* [jmp *0x0(%r13)] *)
+let is_frame_return data off size o ilen =
+  ilen = 4
+  && o >= 0
+  && o + 4 <= size
+  && byte data (off + o) = 0x41
+  && byte data (off + o + 1) = 0xff
+  && byte data (off + o + 2) = 0x65
+  && byte data (off + o + 3) = 0x00
+;;
+
+(* [jmp *...]: an optional REX prefix, then FF /4 *)
+let is_indirect_jmp data off size o =
+  let b i = if o + i < size then byte data (off + o + i) else 0 in
+  let p = if b 0 land 0xf0 = 0x40 then 1 else 0 in
+  b p = 0xff && (b (p + 1) lsr 3) land 7 = 4
+;;
+
+(* If the jmp at code offset [o] follows [lea ret(%rip),%reg; mov %reg,0x0(%r13)],
+   the return address and the mv-return address in the return point's header.
+   [load_addr] is where the jitdump's copy of the code was loaded and [base] is where
+   the code is now: the collector may have moved it since (a JIT_CODE_MOVE record),
+   and the mv-return address in the copy is relative to where it was loaded. *)
+let call_return_address data off size ~load_addr ~base o =
+  let b i = byte data (off + i) in
+  let rec find_lea p =
+    if p < Int.max 0 (o - 40)
+    then None
+    else (
+      let rex = b p
+      and op = b (p + 1)
+      and modrm = b (p + 2) in
+      if (rex = 0x48 || rex = 0x4c) && op = 0x8d && modrm land 0xc7 = 0x05
+      then (
+        let disp = Int32.to_int_exn (Stdlib.String.get_int32_le data (off + p + 3)) in
+        let target = p + 7 + disp in
+        if target <= o || target > size
+        then find_lea (p - 1)
+        else (
+          let reg = ((modrm lsr 3) land 7) lor if rex = 0x4c then 8 else 0 in
+          let rec find_mov q =
+            if q >= o - 3
+            then None
+            else (
+              let mrex = b q
+              and mop = b (q + 1)
+              and mmod = b (q + 2) in
+              if (mrex = 0x49 || mrex = 0x4d)
+                 && mop = 0x89
+                 && mmod land 0xc7 = 0x45
+                 && b (q + 3) = 0
+                 && ((mmod lsr 3) land 7) lor (if mrex = 0x4d then 8 else 0) = reg
+              then (
+                let mvret =
+                  if target >= 0x20
+                  then (
+                    let mv = Stdlib.String.get_int64_le data (off + target - 0x20) in
+                    Some Int64.(mv - load_addr + base))
+                  else None
+                in
+                Some (Int64.(base + of_int target), mvret))
+              else find_mov (q + 1))
+          in
+          find_mov (p + 7)))
+      else find_lea (p - 1))
+  in
+  if o < 7 || o > size then None else find_lea (o - 7)
+;;
+
+let thread_state t thread =
+  Hashtbl.find_or_add t.threads thread ~default:(fun () ->
+    { Thread_state.stack = []; depth = 0; last_time = None; tracing_stopped = false
+    ; saved = Hashtbl.create (module Int64) })
+;;
+
+let name_of (loc : Event.Location.t) =
+  String.map (Symbol.display_name loc.symbol) ~f:(function
+    | ';' | ' ' -> '_'
+    | c -> c)
+;;
+
+let path_on (below : Frame.t list) loc =
+  match below with
+  | [] -> name_of loc
+  | f :: _ -> f.path ^ ";" ^ name_of loc
+;;
+
+(* The stack operations below mirror what the writer does with the events we emit. *)
+
+let run_on (below : Frame.t list) (loc : Event.Location.t) =
+  match below with
+  | f :: _ when Symbol.equal f.loc.symbol loc.symbol -> f.run + 1
+  | _ -> 1
+;;
+
+let max_runs : (string, int) Hashtbl.t = Hashtbl.create (module String)
+
+let note_run (f : Frame.t) =
+  if f.run > 1
+  then
+    Hashtbl.update max_runs (name_of f.loc) ~f:(function
+      | Some r when r >= f.run -> r
+      | _ -> f.run)
+;;
+
+let push (ts : Thread_state.t) ?ret ?mvret loc =
+  let f = { Frame.loc; ret; mvret; path = path_on ts.stack loc; run = run_on ts.stack loc } in
+  note_run f;
+  ts.stack <- f :: ts.stack;
+  ts.depth <- ts.depth + 1;
+  Option.iter ret ~f:(fun r -> Hashtbl.set ts.saved ~key:r ~data:ts.stack);
+  Option.iter mvret ~f:(fun r -> Hashtbl.set ts.saved ~key:r ~data:ts.stack)
+;;
+
+let pop (ts : Thread_state.t) =
+  match ts.stack with
+  | [] -> ()
+  | _ :: rest ->
+    ts.stack <- rest;
+    ts.depth <- ts.depth - 1
+;;
+
+(* the writer's [check_current_symbol]: rename the top frame (keeping its return
+   address, as a tail call does) or start a stack *)
+let check_symbol (ts : Thread_state.t) (loc : Event.Location.t) =
+  match ts.stack with
+  | f :: rest when not (Symbol.equal f.loc.symbol loc.symbol) ->
+    let f = { f with loc; path = path_on rest loc; run = run_on rest loc } in
+    note_run f;
+    ts.stack <- f :: rest
+  | _ :: _ -> ()
+  | [] -> push ts loc
+;;
+
+let clear (ts : Thread_state.t) =
+  ts.stack <- [];
+  ts.depth <- 0
+;;
+
+(* how many frames to pop to return to [dst], if a frame is waiting for it *)
+let frames_to dst (ts : Thread_state.t) =
+  let rec loop n = function
+    | [] -> None
+    | (f : Frame.t) :: rest ->
+      if Option.equal Int64.equal f.ret (Some dst)
+         || Option.equal Int64.equal f.mvret (Some dst)
+      then Some n
+      else loop (n + 1) rest
+  in
+  loop 1 ts.stack
+;;
+
+let make (ok : Event.Ok.t) kind ~(src : Event.Location.t) ~(dst : Event.Location.t)
+  : Event.t
+  =
+  Ok { ok with data = Trace { trace_state_change = None; kind = Some kind; src; dst } }
+;;
+
+(* pop [n] frames: the writer pops one per [Return] and then renames the new top to
+   the return's destination, so every [Return] but the last goes to the frame it
+   exposes *)
+let returns t ok (ts : Thread_state.t) n ~src ~(dst : Event.Location.t) =
+  let rec loop n acc =
+    if n <= 1
+    then (
+      pop ts;
+      check_symbol ts dst;
+      List.rev (make ok Return ~src ~dst :: acc))
+    else (
+      pop ts;
+      let exposed =
+        match ts.stack with
+        | f :: _ -> f.loc
+        | [] -> dst
+      in
+      if List.is_empty ts.stack then check_symbol ts exposed;
+      loop (n - 1) (make ok Return ~src ~dst:exposed :: acc))
+  in
+  if n > 1 then count t "frames popped by multi-frame returns";
+  loop n []
+;;
+
+(* Jump to a return address that no frame on the current stack is waiting for,
+   but that a frame was waiting for earlier: a continuation being reinstated (Racket's
+   engine swaps and threads do this all the time), or a stack the trace lost track of.
+   Switch to the frames that were below that frame, sharing what the two stacks have
+   in common: [Return]s down to the common part, then [Call]s back up. *)
+let switch_stack t ok (ts : Thread_state.t) (target : Frame.t list) ~src ~(dst : Event.Location.t)
+  =
+  let lt = List.length target in
+  let rec drop l n = if n <= 0 then l else drop (List.tl_exn l) (n - 1) in
+  let rec common a b = if phys_equal a b then a else common (List.tl_exn a) (List.tl_exn b) in
+  let base =
+    let a = drop ts.stack (ts.depth - lt)
+    and b = drop target (lt - ts.depth) in
+    common a b
+  in
+  let lbase = List.length base in
+  let npop = ts.depth - lbase in
+  let to_push = List.rev (List.take target (lt - lbase)) (* bottom first *) in
+  let events = ref [] in
+  let emit e = events := e :: !events in
+  let to_push = ref to_push in
+  for _ = 1 to npop do
+    pop ts;
+    let exposed =
+      match ts.stack, !to_push with
+      | f :: _, _ -> f.loc
+      | [], f :: rest ->
+        (* the writer starts a new stack with this frame *)
+        to_push := rest;
+        ts.stack <- [ f ];
+        ts.depth <- 1;
+        f.loc
+      | [], [] -> dst
+    in
+    if List.is_empty ts.stack then check_symbol ts exposed;
+    emit (make ok Return ~src ~dst:exposed)
+  done;
+  List.iter !to_push ~f:(fun (f : Frame.t) ->
+    emit (make ok Call ~src ~dst:f.loc));
+  ts.stack <- target;
+  ts.depth <- lt;
+  Hashtbl.update t.stats "frames popped by stack switches" ~f:(fun v ->
+    Option.value v ~default:0 + npop);
+  Hashtbl.update t.stats "frames pushed by stack switches" ~f:(fun v ->
+    Option.value v ~default:0 + List.length !to_push);
+  check_symbol ts dst;
+  emit (make ok Jump ~src ~dst);
+  List.rev !events
+;;
+
+(* a jump to [dst] that matches no frame: switch to the stack saved for [dst], if any *)
+let switch_to_saved t ok (ts : Thread_state.t) ~src ~(dst : Event.Location.t) =
+  match Hashtbl.find ts.saved dst.instruction_pointer with
+  | Some (_ :: (_ :: _ as below)) -> Some (switch_stack t ok ts below ~src ~dst)
+  | _ -> None
+;;
+
+let call t ok ts ?ret ?mvret ~src ~(dst : Event.Location.t) () =
+  ignore t;
+  push ts ?ret ?mvret dst;
+  [ make ok Call ~src ~dst ]
+;;
+
+let jump ok ts ~src ~dst =
+  check_symbol ts dst;
+  [ make ok Jump ~src ~dst ]
+;;
+
+let classify t (ok : Event.Ok.t) ts (extra : Extra.t) kind ~src ~(dst : Event.Location.t)
+  =
+  let dst_ip = dst.instruction_pointer in
+  match (kind : Event.Kind.t) with
+  | Call ->
+    count t "C calls";
+    call
+      t
+      ok
+      ts
+      ~ret:Int64.(src.Event.Location.instruction_pointer + of_int extra.ilen)
+      ~src
+      ~dst
+      ()
+  | Return ->
+    (match frames_to dst_ip ts with
+     | Some n ->
+       count t "C returns matched";
+       returns t ok ts n ~src ~dst
+     | None ->
+       (match switch_to_saved t ok ts ~src ~dst with
+        | Some events ->
+          count t "C returns to a saved stack";
+          events
+        | None ->
+          count t "C returns unmatched (renamed top)";
+          jump ok ts ~src ~dst))
+  | _ ->
+    (match frames_to dst_ip ts with
+     | Some n ->
+       count t "returns matched";
+       returns t ok ts n ~src ~dst
+     | None ->
+       let src_code = code_of t extra.src_dso in
+       let indirect =
+         match src_code with
+         | Some (data, _, off, size) -> is_indirect_jmp data off size src.symbol_offset
+         | None -> false
+       in
+       (match if indirect then switch_to_saved t ok ts ~src ~dst else None with
+        | Some events ->
+          count t "returns to a saved stack (continuation switch)";
+          events
+        | None ->
+       match src_code with
+        | Some (data, load_addr, off, size) ->
+          let o = src.symbol_offset in
+          let base = Int64.(src.instruction_pointer - of_int o) in
+          if is_frame_return data off size o extra.ilen
+          then (
+            count t "returns unmatched (resync: pop one)";
+            returns t ok ts 1 ~src ~dst)
+          else (
+            match call_return_address data off size ~load_addr ~base o with
+            | Some (ret, mvret) ->
+              count t "non-tail calls";
+              Hashtbl.incr t.entries (name_of dst);
+              call t ok ts ~ret ?mvret ~src ~dst ()
+            | None ->
+              if dst.symbol_offset = 0 && is_jitted extra.dst_dso
+              then (
+                count t "tail calls";
+                Hashtbl.incr t.entries (name_of dst))
+              else count t "other jumps";
+              jump ok ts ~src ~dst)
+        | None ->
+          if dst.symbol_offset = 0 && is_jitted extra.dst_dso
+          then (
+            count t "jumps from C to a Scheme entry";
+            Hashtbl.incr t.entries (name_of dst))
+          else count t "other jumps";
+          jump ok ts ~src ~dst))
+;;
+
+(* the writer's handling of the events we pass on unchanged *)
+let mirror_passthrough (ts : Thread_state.t) (data : Event.Ok.Data.t) =
+  match data with
+  | Trace { kind; trace_state_change; src = _; dst } ->
+    (match kind, trace_state_change with
+     | Some Call, (None | Some End) -> push ts dst
+     | (None | Some Async), Some End -> push ts Event.Location.untraced
+     | Some Syscall, Some End -> push ts Event.Location.syscall
+     | Some Return, Some End -> push ts Event.Location.returned
+     | None, Some Start -> if List.is_empty ts.stack then push ts dst else pop ts
+     | Some (Jump | Interrupt | Tx_abort | Return), None -> check_symbol ts dst
+     | _ -> ())
+  | _ -> ()
+;;
+
+let weigh t (ts : Thread_state.t) time =
+  (match t.folded, ts.last_time, ts.stack with
+   | Some folded, Some last, f :: _ ->
+     let d = Time_ns.Span.to_int_ns Time_ns.Span.(time - last) in
+     if d > 0 then Hashtbl.update folded f.path ~f:(fun v -> Option.value v ~default:0 + d)
+   | _ -> ());
+  ts.last_time <- Some time
+;;
+
+let keep_stack_on_error = not Env_vars.chez_clear_stack_on_error
+
+let process t (event : Event.t) (extra : Extra.t option) : Event.t list =
+  match event with
+  | Error err ->
+    if keep_stack_on_error
+    then (
+      (* After an overflow or a mismatch, the program carries on in the same frames,
+         and the return-address matching resynchronizes the stack, so keep it instead
+         of letting the writer drop it (which truncates every later stack). The next
+         trace start then just moves to where tracing resumed. *)
+      count t "decode errors (stack kept)";
+      Option.iter (Hashtbl.find t.threads err.thread) ~f:(fun ts ->
+        ts.tracing_stopped <- false);
+      [])
+    else (
+      count t "decode errors (stack cleared)";
+      Option.iter (Hashtbl.find t.threads err.thread) ~f:clear;
+      [ event ])
+  | Ok ok ->
+    let ts = thread_state t ok.thread in
+    weigh t ts ok.time;
+    let out =
+      match ok.data, extra with
+      | Trace { kind = Some ((Call | Return | Jump) as kind); trace_state_change = None; src; dst }
+      , Some extra ->
+        if extra.is_jcc
+        then
+          (* conditional branches stay inside one code object; drop those, which
+             cannot change the writer's stack either *)
+          if Symbol.equal src.symbol dst.symbol
+          then []
+          else (
+            check_symbol ts dst;
+            [ event ])
+        else classify t ok ts extra kind ~src ~dst
+      | Trace { trace_state_change = None; kind = Some Iret; src; dst }, _ ->
+        (* In a userspace trace, perf reports a return from a signal handler as an
+           iret to the interrupted instruction. Pop to the nearest frame running that
+           code instead of letting the writer clear the stack. *)
+        let rec find i = function
+          | [] -> None
+          | (f : Frame.t) :: rest ->
+            if Symbol.equal f.loc.symbol dst.symbol then Some i else find (i + 1) rest
+        in
+        (match find 0 ts.stack with
+         | Some 0 | None ->
+           count t "signal returns (iret) as jumps";
+           jump ok ts ~src ~dst
+         | Some n ->
+           count t "signal returns (iret) popping handler frames";
+           returns t ok ts n ~src ~dst)
+      | Trace { trace_state_change = Some Start; kind = _; src; dst }, _
+        when keep_stack_on_error && not ts.tracing_stopped ->
+        (* a start with no end before it: tracing resumed after a decode error *)
+        check_symbol ts dst;
+        [ make ok Jump ~src ~dst ]
+      | data, _ ->
+        (match data with
+         | Trace { trace_state_change = Some End; _ } -> ts.tracing_stopped <- true
+         | Trace { trace_state_change = Some Start; _ } -> ts.tracing_stopped <- false
+         | _ -> ());
+        mirror_passthrough ts data;
+        [ event ]
+    in
+    (match extra with
+     | Some { dst_dso; is_jcc = false; _ } when is_jitted dst_dso ->
+       Hashtbl.incr t.depth_hist ts.depth;
+       if ts.depth > t.max_depth then t.max_depth <- ts.depth
+     | _ -> ());
+    out
+;;
+
+let report t ~folded_path =
+  let sorted tbl =
+    Hashtbl.to_alist tbl |> List.sort ~compare:(fun (_, a) (_, b) -> Int.compare b a)
+  in
+  eprintf "chez mode: max Scheme-event depth %d\n" t.max_depth;
+  List.iter
+    (Hashtbl.to_alist t.stats |> List.sort ~compare:[%compare: string * int])
+    ~f:(fun (k, v) -> eprintf "chez mode: %-40s %d\n" k v);
+  eprintf
+    "chez mode: top Scheme entries (non-tail + tail calls): %s\n"
+    (List.take (sorted t.entries) 10
+     |> List.map ~f:(fun (k, v) -> sprintf "%s=%d" k v)
+     |> String.concat ~sep:", ");
+  eprintf
+    "chez mode: deepest self-recursion (frames in a row): %s\n"
+    (List.take (sorted max_runs) 8
+     |> List.map ~f:(fun (k, v) -> sprintf "%s=%d" k v)
+     |> String.concat ~sep:", ");
